name: Deploy OPD 2 Workforce to GitHub Pages

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: github-pages
  cancel-in-progress: true

jobs:
  deploy:
    name: Build and deploy static site
    runs-on: ubuntu-latest

    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Configure GitHub Pages
        uses: actions/configure-pages@v5

      - name: Configure central Google Sheets API
        env:
          OPD2_SHEETS_API_URL: ${{ vars.OPD2_SHEETS_API_URL }}
          OPD2_API_BASE: ${{ vars.OPD2_API_BASE }}
        run: |
          if [ -n "$OPD2_SHEETS_API_URL" ]; then
            cat > opd2-config.js <<EOF
          // Generated by GitHub Actions. Google Apps Script Web App URL only.
          window.OPD2_SHEETS_API_URL = "$OPD2_SHEETS_API_URL";
          window.OPD2_API_BASE = "";
          window.OPD2_API_KEY = "";
          EOF
          elif [ -n "$OPD2_API_BASE" ]; then
            cat > opd2-config.js <<EOF
          // Generated by GitHub Actions for the legacy self-hosted API.
          window.OPD2_SHEETS_API_URL = "";
          window.OPD2_API_BASE = "$OPD2_API_BASE";
          window.OPD2_API_KEY = "";
          EOF
          else
            echo "Set OPD2_SHEETS_API_URL to the deployed Google Apps Script Web App URL before deploying."
            exit 1
          fi

      - name: Upload static files
        uses: actions/upload-pages-artifact@v3
        with:
          path: .

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
